# ===========================================
# ENVIRONMENT CONFIGURATION
# ===========================================
# Options: staging, preprod, production
# Or run with: npm run test:staging, npm run test:preprod, npm run test:prod
ENVIRONMENT=preprod

# ===========================================
# ENVIRONMENT URLs
# (Override the defaults in configs/env.ts)
# ===========================================
STAGING_BASE_URL=https://gatotkaca.tiket.com
STAGING_API_URL=https://gatotkaca.tiket.com

PREPROD_BASE_URL=https://preprod.tiket.com
PREPROD_API_URL=https://preprod.tiket.com

PRODUCTION_BASE_URL=https://tiket.com
PRODUCTION_API_URL=https://tiket.com

# ===========================================
# GOOGLE SHEETS INTEGRATION (Optional)
# Required only if using testData fixture from fixtures.ts
# ===========================================
SHEET_ID=your-google-sheet-id
SHEET_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
SHEET_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----