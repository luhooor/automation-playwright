{
    "type": "module",
    "name": "playwright-automation",
    "version": "1.0.0",
    "description": "",
    "imports": {
        "#utils/*": "./src/utils/*",
        "#pages/*": "./src/pages/*",
        "#configs/*": "./configs/*"
    },
    "scripts": {
        "test": "playwright test",
        "test:chrome:case": "playwright test --project=chromium -g",
        "test:chrome:case:headed": "playwright test --headed --project=chromium -g",
        "test:staging": "ENVIRONMENT=staging playwright test",
        "test:preprod": "ENVIRONMENT=preprod playwright test",
        "test:prod": "ENVIRONMENT=production playwright test",
        "test:ui": "playwright test src/tests/ui",
        "test:ui:staging": "ENVIRONMENT=staging playwright test src/tests/ui",
        "test:ui:preprod": "ENVIRONMENT=preprod playwright test src/tests/ui",
        "test:ui:prod": "ENVIRONMENT=production playwright test src/tests/ui",
        "test:api": "playwright test src/tests/api",
        "test:api:staging": "ENVIRONMENT=staging playwright test src/tests/api",
        "test:api:preprod": "ENVIRONMENT=preprod playwright test src/tests/api",
        "test:api:prod": "ENVIRONMENT=production playwright test src/tests/api",
        "test:headed": "playwright test --headed",
        "test:debug": "playwright test --debug",
        "test:report": "playwright show-report",
        "test:codegen": "playwright codegen",
        "test:ui:case": "playwright test src/tests/ui -g",
        "report": "playwright show-report",
        "lint": "eslint src configs --ext .ts",
        "lint:fix": "eslint src configs --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\" \"configs/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"configs/**/*.ts\"",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [],
    "author": "Yanuar Luhur Kurniawan",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@playwright/test": "^1.57.0",
        "@types/node": "^25.0.3",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.0.0",
        "prettier": "^3.4.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "dotenv": "^17.2.3",
        "google-auth-library": "^10.5.0",
        "google-spreadsheet": "^5.0.2",
        "winston": "^3.19.0"
    }
}
